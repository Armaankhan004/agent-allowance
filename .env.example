# ==============================================================================
# Agent Allowance - Environment Configuration Example
# Copy this file to .env and fill in your actual sandbox credentials.
# NEVER commit .env to version control!
# ==============================================================================

# PayPal Developer Platform (SANDBOX ONLY)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# LLM Provider Configuration
# Supported providers: gemini or mock (also accepts openai, anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
# LLM Model (e.g. gemini-2.5-flash for Gemini, or mock-agent for Mock)
LLM_MODEL=gemini-2.5-flash

# Starting mode for new sessions: mock or gemini (Mock is forced when no key is set).
# Visitors can switch modes in the sidebar.
DEFAULT_MODE=mock
# Max real Gemini requests per browser session. Mock mode is never capped.
LLM_SESSION_CAP=10

# Public demo safety: gate the Reset button and never show raw exceptions.
# For a public deploy, also set STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=none.
DEMO_PUBLIC=false

# Application & Storage Settings
DATABASE_PATH=agent_allowance.db
DEFAULT_CURRENCY=USD
APP_ENV=development
APP_BASE_URL=http://localhost:8501
